FROM node:20-alpine

RUN apk add --no-cache curl

WORKDIR /app

# Install root-level deps (relayer uses sdk as a local path dep)
COPY sdk/package*.json ./sdk/
COPY relayer/package*.json ./relayer/
COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build --workspace=sdk

EXPOSE 3000
