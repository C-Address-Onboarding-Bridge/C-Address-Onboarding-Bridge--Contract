    "@types/node": "^20.0.0",
    "eslint": "^8.57.1",
    "typescript": "^5.3.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typedoc": "^0.26.0"
