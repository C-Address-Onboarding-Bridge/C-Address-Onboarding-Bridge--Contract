# -------------------------------------------------------------------
# C-Address Onboarding Bridge — local development environment
# Copy to .env and fill in real values. Never commit .env.
# -------------------------------------------------------------------

# ---- Stellar / Soroban ----
STELLAR_RPC_URL=http://localhost:8000/soroban/rpc
# Backwards-compatible alias for older indexer configs.
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
NETWORK_PASSPHRASE=Standalone Network ; February 2017
# Set after deploying locally.
CONTRACT_ID=

# ---- Admin keypair (generate with: stellar keys generate --network local) ----
ADMIN_SECRET_KEY=S...
ADMIN_PUBLIC_KEY=G...

# ---- Fee collector keypair ----
FEE_COLLECTOR_SECRET_KEY=S...
FEE_COLLECTOR_PUBLIC_KEY=G...

# ---- Relayer ----
# Preferred (see adr/ADR-007-signer-key-isolation.md): comma-separated URLs of
# independent per-operator signer services (relayer/signer-service.ts), one
# per relayer node. The main relayer never sees these keys.
RELAYER_SIGNER_URLS=http://signer-a.internal:4000,http://signer-b.internal:4000
# Legacy/dev-only fallback used when RELAYER_SIGNER_URLS is not set: loads
# every relayer's key directly into this process. Do NOT use with more than
# one key in production — it defeats the multi-sig threshold.
RELAYER_PRIVATE_KEYS=aabbcc...
# Stellar keypair used to submit Soroban transactions (pays fees)
RELAYER_SECRET_KEY=S...
THRESHOLD=1
# Optional: where to persist processed-nonce / dead-letter state across restarts
# (defaults to .relayer-nonces.json / .relayer-dlq.json in the working directory)
NONCE_STORE_PATH=
DEAD_LETTER_STORE_PATH=

# ---- Signer service (relayer/signer-service.ts) ----
# Run once per relayer operator, on infrastructure that operator controls.
# Holds exactly one key; never set alongside other operators' keys.
SIGNER_PRIVATE_KEY=aabbcc...
SIGNER_PORT=4000

# ---- Database ----
DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge

# ---- Indexer ----
LISTEN_ADDR=0.0.0.0:3001
# Required API key for POST/DELETE subscription management and event replay.
API_KEY=

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Ethereum listener (optional) ----
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
ETH_BRIDGE_CONTRACT=0x...
# keccak256("BridgeFund(bytes32,string,string,uint256)")
ETH_EVENT_TOPIC=0x...
# Blocks to hold back from the chain head before acting on a log (reorg safety). Defaults to 12.
ETH_CONFIRMATIONS=12

# ---- Solana listener (optional) ----
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_PROGRAM_ID=...
# HTTP RPC endpoint used to backfill events missed while the WS was down
SOLANA_HTTP_URL=https://api.mainnet-beta.solana.com
# Required when SOLANA_WS_URL is set. Arbitrary numeric id agreed with the
# Stellar-side contract to distinguish Solana mainnet/devnet/testnet
# (101 = mainnet-beta by convention in this bridge).
SOLANA_CHAIN_ID=101

# ---- On-ramp integrations (optional) ----
MOONPAY_API_KEY=
TRANSAK_API_KEY=
