{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "../sdk/src/*": ["../sdk/src/*"]
    },
    "baseUrl": "."
  },
  "include": ["index.ts"],
  "exclude": ["node_modules", "dist"]
}
